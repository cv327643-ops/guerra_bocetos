# Copia este archivo a .env para desarrollo local (no lo subas a git).
# En Railway, configura estas mismas variables en Settings -> Variables del servicio.

# URL del proyecto de Supabase (Project Settings -> API)
SUPABASE_URL=https://hiewaojvwruxtwncatnf.supabase.co

# Service role key del proyecto (Project Settings -> API -> service_role)
# NUNCA la expongas en el frontend ni la subas a git. Solo vive en el servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Puerto local (Railway lo asigna automaticamente en produccion)
PORT=3000
